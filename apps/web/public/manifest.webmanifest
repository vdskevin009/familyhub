{
  "name": "FamilyHub",
  "short_name": "FamilyHub",
  "id": "/familyhub/",
  "start_url": "/familyhub/",
  "scope": "/familyhub/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f2f5f1",
  "theme_color": "#173f35",
  "description": "Your proactive household assistant for plans, money, meals, inbox and everyday admin.",
  "categories": ["productivity", "finance", "lifestyle"],
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "short_name": "Today", "url": "/familyhub/?view=today" },
    { "name": "Inbox", "short_name": "Inbox", "url": "/familyhub/?view=inbox" },
    { "name": "Plan meals", "short_name": "Meals", "url": "/familyhub/?view=plan" },
    { "name": "Money", "short_name": "Money", "url": "/familyhub/?view=money" }
  ]
}
