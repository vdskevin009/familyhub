@inject BrowserStore Store
<section class="savings-intro"><div class="eyebrow">FAMILYHUB / SAVE A LITTLE MORE</div><h2>Your savings workspace</h2><p>Small recurring costs. Smarter shopping. A clearer renewal decision.</p><span class="badge">CAD · MANUAL INPUTS · SAVED ON THIS DEVICE</span></section>
@if (error.Length > 0) { <p class="error" role="alert">@error</p> }
@if (message.Length > 0) { <p class="success" role="status">@message</p> }
@if (blocked) { <p>Existing savings data could not be read. Export the stored data before recovering from a backup.</p><button @onclick="ExportRaw">Download stored data</button> }
<div class="tabs" aria-label="Savings tools">@foreach (var t in new[] { "Subscription Hunter", "Grocery Price Optimizer", "Mortgage Renewal Optimizer" }) { <button class="@(tab == t ? "active" : "")" aria-pressed="@(tab == t)" @onclick="() => tab = t">@t</button> }</div>
@if (tab == "Subscription Hunter") {
<section class="stats"><div class="stat"><small>ACTIVE ANNUAL COST</small><strong>@Money(state.Subscriptions.Where(s => !s.Cancelled).Sum(s => s.AnnualCost))</strong></div><div class="stat"><small>FLAGGED FOR REVIEW / YEAR</small><strong>@Money(state.Subscriptions.Where(s => !s.Cancelled && s.Review).Sum(s => s.AnnualCost))</strong></div><div class="stat"><small>CANCELLED ANNUAL RUN RATE</small><strong>@Money(state.Subscriptions.Where(s => s.Cancelled).Sum(s => s.AnnualCost))</strong></div></section>
<p class="notice">Annualized estimates, not money already saved. Flag unused or overlapping services for review. Cancel with the provider before marking a subscription cancelled here.</p>
<div class="grid"><section class="card"><h2>Your subscriptions</h2>
@if (!state.Subscriptions.Any()) { <p class="empty">Add your first subscription to find recurring costs.</p> }
@foreach (var s in state.Subscriptions.OrderBy(s => s.Cancelled).ThenBy(s => s.Renewal)) {
<div class="row" @key="s.Id"><div class="grow"><strong>@s.Name</strong><small>@Money(s.Price) / @s.Cycle · @Money(s.AnnualCost) per year</small><small>Next charge entered: @s.Renewal.ToString("d MMM yyyy")</small>
@if (!s.Cancelled && s.Renewal.Date <= DateTime.Today.AddDays(30)) { <span class="badge warn">@(s.Renewal.Date < DateTime.Today ? "Charge date passed — update it" : "Due within 30 days")</span> }
@if (state.Subscriptions.Count(x => !x.Cancelled && x.Name.Trim().Equals(s.Name.Trim(), StringComparison.OrdinalIgnoreCase)) > 1) { <span class="badge warn">Possible duplicate</span> }
@if (s.Review && !s.Cancelled) { <span class="badge">Review</span> } @if (s.Cancelled) { <span class="badge">Cancelled</span> }
</div><div class="actions"><button class="secondary" @onclick="() => EditSubscription(s)">Edit</button><button class="secondary" disabled="@blocked" @onclick="() => ToggleSubscription(s.Id)">@(s.Cancelled ? "Reactivate" : "Mark cancelled")</button><button class="danger" disabled="@blocked" aria-label="@($"Delete {s.Name}")" @onclick="() => DeleteSubscription(s.Id)">Delete</button></div></div>
}</section><section class="card"><h2>@(editSub ? "Edit subscription" : "Add a subscription")</h2><form @onsubmit="SaveSubscription" @onsubmit:preventDefault><div class="form-grid">
<label class="full">Service<input @bind="sub.Name" required maxlength="100" placeholder="e.g. Streaming service" /></label><label>Cost including tax (CAD)<input type="number" @bind="sub.Price" min="0" max="100000" step="0.01" required /></label><label>Billing cycle<select @bind="sub.Cycle">@foreach (var c in Enum.GetValues<BillingCycle>()) { <option value="@c">@c</option> }</select></label><label>Next charge<input type="date" @bind="sub.Renewal" min="2000-01-01" max="2100-12-31" required /></label><label class="checkline"><input type="checkbox" @bind="sub.Review" />Review for cancellation</label><div class="actions full"><button disabled="@blocked">Save subscription</button><button type="button" class="secondary" @onclick="() => { sub = new(); editSub = false; }">Clear</button></div></div></form></section></div>
}
@if (tab == "Grocery Price Optimizer") {
<p class="notice">Enter receipt or flyer prices. Match the same product and unit (convert grams to kg and mL to litres). Expired offers stay in your history but are excluded from comparisons. No live store feed.</p>
<div class="grid"><section class="card"><h2>Compare your next purchase</h2><div class="form-grid"><label>Product<input @bind="product" placeholder="e.g. Apples" list="products" /></label><datalist id="products">@foreach (var p in state.Offers.Select(o => o.Product).Distinct()) { <option value="@p" /> }</datalist><label>Unit<select @bind="unit">@foreach (var u in Enum.GetValues<GroceryUnit>()) { <option value="@u">@u</option> }</select></label><label>Quantity needed<input type="number" @bind="quantity" min="0.001" max="100000" step="0.001" /></label></div>
@{ var matches = SavingsMath.Compare(state.Offers, product, unit, DateTime.Today).ToList(); }
@if (matches.Count == 0) { <p class="empty">Choose a product with an unexpired price to compare stores.</p> }
else if (quantity <= 0 || quantity > 100000) { <p role="alert">Enter a quantity greater than zero and no more than 100,000.</p> }
else {
var ranked = matches.OrderBy(o => Math.Ceiling(quantity / o.Size) * o.Price).ToList();
<p class="success">Lowest entered pack cost: <strong>@ranked[0].Store · @Money(Math.Ceiling(quantity / ranked[0].Size) * ranked[0].Price)</strong></p>
<div class="table-wrap"><table><caption>Whole packs needed for @quantity @unit of @product</caption><thead><tr><th>Store</th><th>Per unit</th><th>Packs</th><th>Total</th></tr></thead><tbody>@foreach (var o in ranked) { <tr><td>@o.Store</td><td>@Money(o.UnitPrice) / @o.Unit</td><td>@Math.Ceiling(quantity / o.Size)</td><td>@Money(Math.Ceiling(quantity / o.Size) * o.Price)</td></tr> }</tbody></table></div>
<p class="notice">Difference between highest and lowest entered pack cost: @Money(ranked.Max(o => Math.Ceiling(quantity / o.Size) * o.Price) - ranked.Min(o => Math.Ceiling(quantity / o.Size) * o.Price)). Include applicable taxes in prices; travel costs, availability and membership restrictions are not calculated.</p>
}
<h3>Price history</h3>@foreach (var o in state.Offers.OrderBy(o => o.Product).ThenBy(o => o.Store)) { <div class="row"><div class="grow"><strong>@o.Product · @o.Store</strong><small>@Money(o.Price) / @o.Size @o.Unit · valid through @o.ValidUntil.ToString("d MMM yyyy")</small>@if (o.ValidUntil.Date < DateTime.Today) { <span class="badge warn">Expired</span> }</div><button class="secondary" @onclick="() => EditOffer(o)">Edit</button><button class="danger" disabled="@blocked" @onclick="() => DeleteOffer(o.Id)">Delete</button></div> }
</section><section class="card"><h2>@(editOffer ? "Edit price" : "Add a store price")</h2><form @onsubmit="SaveOffer" @onsubmit:preventDefault><div class="form-grid"><label>Product<input @bind="offer.Product" required maxlength="100" list="products" /></label><label>Store<input @bind="offer.Store" required maxlength="100" /></label><label>Pack price (CAD)<input type="number" @bind="offer.Price" min="0" max="100000" step="0.01" required /></label><label>Pack size<input type="number" @bind="offer.Size" min="0.001" max="100000" step="0.001" required /></label><label>Unit<select @bind="offer.Unit">@foreach (var u in Enum.GetValues<GroceryUnit>()) { <option value="@u">@u</option> }</select></label><label>Valid through<input type="date" @bind="offer.ValidUntil" min="2000-01-01" max="2100-12-31" required /></label><div class="actions full"><button disabled="@blocked">Save price</button><button type="button" class="secondary" @onclick="() => { offer = new(); editOffer = false; }">Clear</button></div></div></form></section></div>
}
@if (tab == "Mortgage Renewal Optimizer") {
<p class="notice">Compare two fixed-rate scenarios at renewal using the same balance, amortization and term. Rates are entered by you, not live offers. Estimates use monthly payments and Canadian semi-annual compounding; fees are paid upfront. This is a planning calculator, not a lender quote.</p>
<div class="grid"><section class="card"><h2>Your renewal scenario</h2><form @onsubmit="Calculate" @onsubmit:preventDefault><div class="form-grid"><label class="full">Expected balance at renewal (CAD)<input type="number" @bind="mortgage.Balance" min="1" max="100000000" step="0.01" required /></label><label>Baseline offer rate (%)<input type="number" @bind="mortgage.BaseRate" min="0" max="30" step="0.001" required /></label><label>Alternative offer rate (%)<input type="number" @bind="mortgage.OfferRate" min="0" max="30" step="0.001" required /></label><label>Remaining amortization (years)<input type="number" @bind="mortgage.Years" min="1" max="40" required /></label><label>Comparison term (months)<input type="number" @bind="mortgage.TermMonths" min="1" max="480" required /></label><label>Extra switching fees (CAD)<input type="number" @bind="mortgage.Fees" min="0" max="1000000" step="0.01" required /></label><label>Renewal date<input type="date" @bind="mortgage.Renewal" min="2000-01-01" max="2100-12-31" required /></label><button disabled="@blocked">Calculate & save</button></div></form></section><section class="card tinted"><h2>Compare the full term</h2>
@if (baseline is null || alternative is null) { <p>Enter your expected renewal balance and two rates to compare payments, interest and the remaining balance.</p> }
else { <p class="badge">SAVED SCENARIO · @state.Mortgage.TermMonths MONTHS</p><div class="table-wrap"><table><thead><tr><th>Estimate</th><th>Baseline</th><th>Alternative</th></tr></thead><tbody><tr><th>Monthly payment</th><td>@Money(baseline.Payment)</td><td>@Money(alternative.Payment)</td></tr><tr><th>Term interest</th><td>@Money(baseline.Interest)</td><td>@Money(alternative.Interest)</td></tr><tr><th>Remaining balance</th><td>@Money(baseline.Remaining)</td><td>@Money(alternative.Remaining)</td></tr></tbody></table></div><p><strong>Net interest savings after fees: @Money(baseline.Interest - alternative.Interest - state.Mortgage.Fees)</strong></p><p>Monthly payment difference: @Money(baseline.Payment - alternative.Payment). Negative savings mean the alternative costs more.</p><p class="notice">Based on your last saved calculation. Changing the form does not update results until you calculate again. Excludes insurance, taxes, early-break penalties and future rate changes; include any known extra costs in fees.</p><p>Renewal: @state.Mortgage.Renewal.ToString("d MMM yyyy") · @Math.Max(0, (state.Mortgage.Renewal.Date - DateTime.Today).Days) days away.</p> }
<p>Review prepayment privileges, portability, penalties and offer expiry as well as the rate.</p><a href="https://itools-ioutils.fcac-acfc.gc.ca/MC-CH/MC-CH-eng.aspx" target="_blank" rel="noopener noreferrer">FCAC mortgage calculator ↗</a></section></div>
}
<section class="card"><h2>Back up your savings workspace</h2><p class="notice">Savings tools use a separate backup from your family plans. Import replaces savings data on this device after confirmation. Keep the file private; data is not synced or encrypted.</p><div class="actions"><button class="secondary" @onclick="Export">Download savings backup</button><label>Choose savings backup<InputFile OnChange="ReadImport" accept=".json,application/json" /></label></div>@if (pending is not null) { <p>Replace current savings with @pending.Subscriptions.Count subscriptions and @pending.Offers.Count prices?</p><div class="actions"><button @onclick="ConfirmImport">Replace savings data</button><button class="secondary" @onclick="() => pending = null">Cancel</button></div> }</section>
@code {
    SavingsState state = new(); SavingsState? pending;
    Subscription sub = new(); GroceryOffer offer = new(); MortgageScenario mortgage = new();
    MortgageResult? baseline, alternative;
    bool editSub, editOffer, blocked;
    string tab = "Subscription Hunter", error = "", message = "", product = "";
    GroceryUnit unit; decimal quantity = 1;
    static string Money(decimal value) => value.ToString("C2", CultureInfo.GetCultureInfo("en-CA"));
    static T Copy<T>(T value) => JsonSerializer.Deserialize<T>(JsonSerializer.Serialize(value))!;
    protected override async Task OnInitializedAsync() { try { state = await Store.Load<SavingsState>("familyhub.savings.v1") ?? new(); state.Validate(); mortgage = Copy(state.Mortgage); Results(); } catch { blocked = true; error = "Savings data could not be read. It has not been overwritten."; } }
    void Results() { baseline = alternative = null; if (state.Mortgage.Balance <= 0) return; var m = state.Mortgage; baseline = SavingsMath.Mortgage(m.Balance, m.BaseRate, m.Years, m.TermMonths); alternative = SavingsMath.Mortgage(m.Balance, m.OfferRate, m.Years, m.TermMonths); }
    async Task<bool> Commit(SavingsState next, bool recovery = false) { try { if (blocked && !recovery) throw new ArgumentException("Recover from a backup first."); next.Validate(); await Store.Save("familyhub.savings.v1", next); state = next; blocked = false; error = ""; message = "Saved on this device."; return true; } catch (Exception ex) { message = ""; error = "Could not save: " + ex.Message; return false; } }
    void EditSubscription(Subscription s) { sub = Copy(s); editSub = true; }
    async Task SaveSubscription() { var next = Copy(state); next.Subscriptions.RemoveAll(s => s.Id == sub.Id); next.Subscriptions.Add(Copy(sub)); if (await Commit(next)) { sub = new(); editSub = false; } }
    async Task ToggleSubscription(Guid id) { var next = Copy(state); var s = next.Subscriptions.Single(s => s.Id == id); s.Cancelled = !s.Cancelled; await Commit(next); }
    async Task DeleteSubscription(Guid id) { var next = Copy(state); next.Subscriptions.RemoveAll(s => s.Id == id); await Commit(next); }
    void EditOffer(GroceryOffer o) { offer = Copy(o); editOffer = true; }
    async Task SaveOffer() { var next = Copy(state); next.Offers.RemoveAll(o => o.Id == offer.Id); next.Offers.Add(Copy(offer)); if (await Commit(next)) { product = offer.Product; unit = offer.Unit; offer = new(); editOffer = false; } }
    async Task DeleteOffer(Guid id) { var next = Copy(state); next.Offers.RemoveAll(o => o.Id == id); await Commit(next); }
    async Task Calculate() { var next = Copy(state); next.Mortgage = Copy(mortgage); if (await Commit(next)) Results(); }
    async Task Export() { try { await Store.Download("familyhub-savings-backup.json", JsonSerializer.Serialize(state, new JsonSerializerOptions { WriteIndented = true })); } catch { error = "Download failed. Please try again."; } }
    async Task ExportRaw() { try { var raw = await Store.LoadRaw("familyhub.savings.v1"); await Store.Download("familyhub-savings-recovery.json", raw ?? ""); } catch { error = "Stored data could not be exported. Use your browser's site storage tools to recover the original value."; } }
    async Task ReadImport(InputFileChangeEventArgs args) { pending = null; try { using var reader = new StreamReader(args.File.OpenReadStream(1_000_000)); var raw = await reader.ReadToEndAsync(); using var doc = JsonDocument.Parse(raw); if (!doc.RootElement.TryGetProperty("Subscriptions", out _) || !doc.RootElement.TryGetProperty("Offers", out _) || !doc.RootElement.TryGetProperty("Mortgage", out _)) throw new ArgumentException("Choose a savings backup, not a family plans backup."); var value = JsonSerializer.Deserialize<SavingsState>(raw) ?? throw new ArgumentException("Empty backup."); value.Validate(); pending = value; error = ""; } catch (Exception ex) { error = "Import failed: " + ex.Message; } }
    async Task ConfirmImport() { if (pending is not null && await Commit(pending, true)) { pending = null; mortgage = Copy(state.Mortgage); sub = new(); offer = new(); editSub = editOffer = false; Results(); } }
}
